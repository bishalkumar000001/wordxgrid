# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/

# ── Optional ──────────────────────────────────────────────────────────────────
OWNER_ID=123456789
LOG_GROUP_ID=-100123456789
SUPPORT_CHANNEL=https://t.me/your_support_group
SUDO_USERS=123456789,987654321

# ── Ludo Mini App ─────────────────────────────────────────────────────────────
# Public HTTPS URL of the web service (set after deploying on Render)
LUDO_WEB_APP_URL=https://your-app-name.onrender.com/ludo

# Secret key for Flask session signing (generate a random string)
WEBAPP_SECRET_KEY=change-this-to-a-random-secret-key

# Turn timeout in seconds (default: 60)
LUDO_TURN_TIMEOUT=60
